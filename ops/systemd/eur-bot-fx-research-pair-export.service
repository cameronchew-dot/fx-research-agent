[Unit]
Description=Export multi-pair market data for the FX research agent
After=eur-bot-farm.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/runtime/eur_bot
EnvironmentFile=/home/ubuntu/runtime/eur_bot/.env
ExecStart=/usr/bin/python3 /home/ubuntu/runtime/eur_bot/scripts/fx_research_pair_market_export.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/ubuntu/runtime/eur_bot
