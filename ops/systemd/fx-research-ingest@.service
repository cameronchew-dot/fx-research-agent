[Unit]
Description=FX research agent ingest command %i
After=eur-bot-farm.service eur-agent.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/runtime/fx_research_agent
EnvironmentFile=/home/ubuntu/runtime/fx_research_agent/.env
ExecStart=/home/ubuntu/runtime/fx_research_agent/.venv/bin/python /home/ubuntu/runtime/fx_research_agent/ops/research_supervisor.py %i
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/ubuntu/runtime/fx_research_agent
