<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.camcam.fx-research-agent.result-reconciliation</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Frameworks/Python.framework/Versions/3.14/bin/python3</string>
    <string>/Users/camcam/fx_research_agent/ops/research_supervisor.py</string>
    <string>sync-research-results</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/camcam/fx_research_agent</string>
  <key>WatchPaths</key>
  <array>
    <string>/Users/camcam/eur_bot/exports/fx_research_results</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>5</integer></dict>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>/Users/camcam/fx_research_agent/data/result_reconciliation.log</string>
  <key>StandardErrorPath</key><string>/Users/camcam/fx_research_agent/data/result_reconciliation.stderr.log</string>
</dict>
</plist>
